---
import SEOHead from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  keywords?: string;
}

const { title, description, image, article, keywords } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      article={article}
      keywords={keywords}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-gray-50">
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
