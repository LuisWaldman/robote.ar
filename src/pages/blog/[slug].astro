---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  return blogPosts.map(post => ({
    params: { slug: post.id.replace('.md', '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return new Date(date).toLocaleDateString('es-AR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout
  title={`${post.data.title} | Blog Robote.ar`}
  description={post.data.description}
  keywords={post.data.keywords}
  image={post.data.image}
  article={true}
>
  <article class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <header class="mb-8">
        <div class="flex flex-wrap gap-2 mb-4">
          {post.data.tags.map(tag => (
            <span class="px-3 py-1 bg-blue-100 text-blue-700 text-sm font-semibold rounded-full">
              {tag}
            </span>
          ))}
        </div>
        
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          {post.data.title}
        </h1>
        
        <div class="flex items-center text-gray-600 text-sm">
          <span>{post.data.author}</span>
          <span class="mx-2">•</span>
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
        </div>
      </header>

      <!-- Content -->
      <div class="prose prose-lg max-w-none">
        <Content />
      </div>

      <!-- Footer -->
      <footer class="mt-12 pt-8 border-t border-gray-200">
        <div class="bg-blue-50 rounded-xl p-8 text-center">
          <h3 class="text-2xl font-bold text-gray-900 mb-3">
            ¿Te gustó este artículo?
          </h3>
          <p class="text-gray-700 mb-6">
            Descubrí cómo automatizar tu negocio con nuestros robots
          </p>
          <a
            href="/robots"
            class="inline-block px-8 py-4 bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-700 hover:to-cyan-600 text-white rounded-full font-bold text-lg transition-colors shadow-lg"
          >
            Ver Nuestros Robots →
          </a>
        </div>
      </footer>

      <!-- Back to Blog -->
      <div class="mt-8 text-center">
        <a href="/blog" class="text-blue-600 hover:text-blue-700 font-semibold">
          ← Volver al Blog
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
