---
import BaseLayout from '../layouts/BaseLayout.astro';
import RobotCard from '../components/RobotCard.astro';
import { robots } from '../data/robots';
---

<BaseLayout
  title="Nuestros Robots de IA - Catálogo Completo | Robote.ar"
  description="Conocé todos nuestros bots especializados: ventas, gastronomía, turismo, muebles, ropa industrial y más. Elegí el robot perfecto para tu PyME."
  keywords="robots ia argentina, chatbots especializados, bot para restaurante, bot para muebleria, bot whatsapp ventas"
>
  <!-- Header -->
  <section class="bg-gradient-to-br from-blue-600 to-cyan-500 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">
        Nuestros Robots Especializados
      </h1>
      <p class="text-xl text-blue-100 max-w-3xl mx-auto">
        {robots.length} bots diseñados específicamente para distintas industrias argentinas
      </p>
    </div>
  </section>

  <!-- Robots Grid -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {robots.map(robot => (
          <RobotCard robot={robot} />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        ¿No encontraste el bot que necesitás?
      </h2>
      <p class="text-xl text-gray-600 mb-8">
        Creamos bots personalizados para tu industria específica
      </p>
      <a
        href="/#contacto"
        class="inline-block px-8 py-4 bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-700 hover:to-cyan-600 text-white rounded-full font-bold text-lg transition-colors shadow-lg"
      >
        Consultá por un Bot Personalizado →
      </a>
    </div>
  </section>
</BaseLayout>
