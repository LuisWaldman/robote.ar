---
import BaseLayout from '../layouts/BaseLayout.astro';
import RobotCard from '../components/RobotCard.astro';
import { robots } from '../data/robots';

const featuredRobots = robots.slice(0, 3);
---

<BaseLayout
  title="Robote.ar - Bots de IA para PyMEs Argentinas | Automatizá tu Negocio"
  description="Automatizá tu PyME con inteligencia artificial. Bots especializados para ventas, atención al cliente y gestión. WhatsApp, Telegram y más. 100% argentino."
  keywords="chatbot argentina, bot whatsapp para negocios, inteligencia artificial pymes, automatización negocios argentina, chatbot para restaurantes, bot ventas whatsapp"
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-blue-600 via-cyan-500 to-blue-700 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-32">
      <div class="text-center">
        <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-tight">
          Automatizá tu PyME con<br />
          <span class="text-yellow-300">Inteligencia Artificial Argentina</span>
        </h1>
        <p class="text-xl md:text-2xl mb-8 text-blue-100 max-w-3xl mx-auto">
          Robots especializados que atienden tus clientes 24/7 por WhatsApp, Telegram y más.
          Sin descanso, sin errores, sin quejas.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href="#robots"
            class="px-8 py-4 bg-yellow-400 hover:bg-yellow-300 text-gray-900 rounded-full font-bold text-lg transition-colors shadow-lg"
          >
            Conocé Nuestros Robots 🤖
          </a>
          <a
            href="#contacto"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 backdrop-blur-sm border-2 border-white text-white rounded-full font-semibold text-lg transition-colors"
          >
            Consultá Gratis
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          ¿Por qué elegir Robote.ar?
        </h2>
        <p class="text-xl text-gray-600">
          La solución que tu negocio necesitaba
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-3xl">⏰</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">24/7 Sin Descanso</h3>
          <p class="text-gray-600">
            Tus clientes atendidos a cualquier hora, incluso feriados y madrugadas
          </p>
        </div>

        <div class="text-center">
          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-3xl">💰</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Reduce Costos</h3>
          <p class="text-gray-600">
            Ahorrá en personal sin perder calidad de atención
          </p>
        </div>

        <div class="text-center">
          <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-3xl">⚡</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Fácil Implementación</h3>
          <p class="text-gray-600">
            Configuramos todo nosotros. Vos solo elegís qué bot necesitás
          </p>
        </div>

        <div class="text-center">
          <div class="w-16 h-16 bg-cyan-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-3xl">🇦🇷</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">100% Argentino</h3>
          <p class="text-gray-600">
            Desarrollado en Argentina para negocios argentinos
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Robots Preview -->
  <section id="robots" class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Conocé a Nuestros Robots
        </h2>
        <p class="text-xl text-gray-600">
          Cada uno especializado en una industria específica
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        {featuredRobots.map(robot => (
          <RobotCard robot={robot} />
        ))}
      </div>

      <div class="text-center">
        <a
          href="/robots"
          class="inline-block px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white rounded-full font-bold text-lg transition-colors"
        >
          Ver todos los robots ({robots.length}) →
        </a>
      </div>
    </div>
  </section>

  <!-- Cómo Funciona -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          ¿Cómo Funciona?
        </h2>
        <p class="text-xl text-gray-600">
          Tres pasos simples para automatizar tu negocio
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="relative">
          <div class="w-20 h-20 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-full flex items-center justify-center mx-auto mb-6 text-white text-3xl font-bold">
            1
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3 text-center">Elegís tu Robot</h3>
          <p class="text-gray-600 text-center">
            Mirás el catálogo y elegís el bot que mejor se adapta a tu industria. ¿No estás seguro? Hablamos y te ayudamos.
          </p>
        </div>

        <div class="relative">
          <div class="w-20 h-20 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center mx-auto mb-6 text-white text-3xl font-bold">
            2
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3 text-center">Configuramos Juntos</h3>
          <p class="text-gray-600 text-center">
            Nos pasás la info de tu negocio (catálogo, precios, horarios). Nosotros configuramos todo y te hacemos una demo.
          </p>
        </div>

        <div class="relative">
          <div class="w-20 h-20 bg-gradient-to-br from-green-500 to-emerald-500 rounded-full flex items-center justify-center mx-auto mb-6 text-white text-3xl font-bold">
            3
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3 text-center">Empieza a Laburar</h3>
          <p class="text-gray-600 text-center">
            Tu bot empieza a atender clientes 24/7. Vos te dedicás a lo importante mientras el bot vende y responde consultas.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Casos de Éxito -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Casos de Éxito
        </h2>
        <p class="text-xl text-gray-600">
          PyMEs argentinas que ya automatizaron con nosotros
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-xl shadow-lg p-8">
          <div class="flex items-center mb-4">
            <div class="w-16 h-16 bg-amber-100 rounded-full flex items-center justify-center mr-4">
              <span class="text-3xl">🪑</span>
            </div>
            <div>
              <h4 class="font-bold text-gray-900">Muebles del Sur</h4>
              <p class="text-sm text-gray-600">Mueblería - CABA</p>
            </div>
          </div>
          <p class="text-gray-700 italic mb-4">
            "Javier nos triplicó las consultas por WhatsApp. Antes perdíamos clientes porque no dábamos abasto. Ahora responde todo al instante."
          </p>
          <p class="text-sm text-gray-600">— Roberto M., Dueño</p>
        </div>

        <div class="bg-white rounded-xl shadow-lg p-8">
          <div class="flex items-center mb-4">
            <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mr-4">
              <span class="text-3xl">🍕</span>
            </div>
            <div>
              <h4 class="font-bold text-gray-900">Pizzería La Nonna</h4>
              <p class="text-sm text-gray-600">Gastronomía - Rosario</p>
            </div>
          </div>
          <p class="text-gray-700 italic mb-4">
            "María toma pedidos mientras nosotros cocinamos. Nunca se confunde con las direcciones y el teléfono deja de sonar sin parar."
          </p>
          <p class="text-sm text-gray-600">— Claudia R., Gerente</p>
        </div>

        <div class="bg-white rounded-xl shadow-lg p-8">
          <div class="flex items-center mb-4">
            <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mr-4">
              <span class="text-3xl">🏡</span>
            </div>
            <div>
              <h4 class="font-bold text-gray-900">Cabañas Valle Grande</h4>
              <p class="text-sm text-gray-600">Turismo - Mendoza</p>
            </div>
          </div>
          <p class="text-gray-700 italic mb-4">
            "Carlos maneja todas las consultas y reservas. Yo puedo estar en la viña tranquilo sabiendo que nadie se queda sin respuesta."
          </p>
          <p class="text-sm text-gray-600">— Juan P., Propietario</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Formulario de Contacto -->
  <section id="contacto" class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          ¿Listo para Automatizar tu Negocio?
        </h2>
        <p class="text-xl text-gray-600">
          Completá el formulario y te contactamos para armar una solución a medida
        </p>
      </div>

      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="bg-gray-50 rounded-xl p-8 shadow-lg"
      >
        <!-- Replace with your Web3Forms access key -->
        <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
        <input type="hidden" name="subject" value="Nueva consulta desde Robote.ar" />
        <input type="hidden" name="from_name" value="Robote.ar Website" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <div>
            <label for="nombre" class="block text-sm font-semibold text-gray-700 mb-2">
              Nombre *
            </label>
            <input
              type="text"
              id="nombre"
              name="nombre"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="Juan Pérez"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">
              Email *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="juan@ejemplo.com"
            />
          </div>
        </div>

        <div class="mb-6">
          <label for="telefono" class="block text-sm font-semibold text-gray-700 mb-2">
            Teléfono (WhatsApp)
          </label>
          <input
            type="tel"
            id="telefono"
            name="telefono"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="+54 9 11 xxxx-xxxx"
          />
        </div>

        <div class="mb-6">
          <label for="mensaje" class="block text-sm font-semibold text-gray-700 mb-2">
            ¿Qué necesitás automatizar? *
          </label>
          <textarea
            id="mensaje"
            name="mensaje"
            required
            rows="5"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="Ej: Tengo una mueblería y quiero automatizar consultas por WhatsApp..."
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full px-8 py-4 bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-700 hover:to-cyan-600 text-white rounded-lg font-bold text-lg transition-colors shadow-lg"
        >
          Enviar Consulta 🚀
        </button>

        <p class="text-sm text-gray-600 mt-4 text-center">
          Te respondemos en menos de 24 horas
        </p>
      </form>
    </div>
  </section>
</BaseLayout>
