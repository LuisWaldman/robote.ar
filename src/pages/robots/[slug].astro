---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { robots } from '../../data/robots';

export async function getStaticPaths() {
  return robots.map(robot => ({
    params: { slug: robot.id },
    props: { robot },
  }));
}

const { robot } = Astro.props;

const accentColors = {
  blue: 'from-blue-500 to-cyan-500',
  amber: 'from-amber-500 to-orange-500',
  green: 'from-green-500 to-emerald-500',
  purple: 'from-purple-500 to-pink-500',
  pink: 'from-pink-500 to-rose-500',
  cyan: 'from-cyan-500 to-blue-500',
  lime: 'from-lime-500 to-green-500',
};

const gradientClass = accentColors[robot.colorAccent as keyof typeof accentColors] || accentColors.blue;
---

<BaseLayout
  title={`${robot.nombre} - Bot de IA para ${robot.industria} | Robote.ar`}
  description={robot.descripcionCorta}
  keywords={`bot ${robot.industria.toLowerCase()}, chatbot ${robot.industria.toLowerCase()} argentina, automatizar ${robot.industria.toLowerCase()}`}
>
  <!-- Hero -->
  <section class={`bg-gradient-to-br ${gradientClass} text-white py-20 relative`}>
    {robot.endesarrollo && (
      <div class="absolute top-0 left-0 w-40 h-40 overflow-hidden z-10">
        <div class="absolute top-8 -left-12 w-52 bg-yellow-500 text-black text-xs font-bold py-1 text-center transform -rotate-45 shadow-lg">
          EN DESARROLLO
        </div>
      </div>
    )}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="mb-6 flex justify-center">
          <img 
            src={robot.imagen} 
            alt={robot.nombre}
            class="w-64 h-64 rounded-full object-cover shadow-2xl border-4 border-white"
          />
        </div>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          {robot.nombre}
        </h1>
        <p class="text-2xl mb-2 opacity-90">
          {robot.industria}
        </p>
        <p class="text-xl italic max-w-3xl mx-auto">
          {robot.descripcionCorta}
        </p>
      </div>
    </div>
  </section>

  <!-- Descripción Completa -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-lg max-w-none">
        {robot.descripcionLarga.split('\n\n').map(paragraph => (
          <p class="text-gray-700 mb-4 text-lg leading-relaxed">
            {paragraph}
          </p>
        ))}
      </div>
    </div>
  </section>

  <!-- Capacidades -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">
        ¿Qué puede hacer {robot.nombre.split(' ')[0]}?
      </h2>
      
      <div class="bg-white rounded-xl shadow-lg p-8">
        <ul class="space-y-4">
          {robot.capacidades.map(capacidad => (
            <li class="flex items-start">
              <svg class="w-6 h-6 text-green-500 mr-3 flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-700 text-lg">{capacidad}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Demos -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">
        Probá {robot.nombre.split(' ')[0]} Ahora
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {robot.demoWhatsApp && (
          <a
            href={robot.endesarrollo ? '#' : robot.demoWhatsApp}
            target={robot.endesarrollo ? '_self' : '_blank'}
            rel="noopener noreferrer"
            class={`block ${robot.endesarrollo ? 'bg-gray-100 border-2 border-gray-300 cursor-not-allowed opacity-60' : 'bg-green-50 border-2 border-green-200 hover:shadow-lg'} rounded-xl p-8 text-center transition-shadow`}
            onclick={robot.endesarrollo ? 'return false;' : ''}
          >
            <svg class="w-16 h-16 mx-auto mb-4 text-green-600" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <h3 class="font-bold text-gray-900 mb-2">Demo en WhatsApp</h3>
            <p class="text-sm text-gray-600 mb-4">Chateá directamente por WhatsApp</p>
            <span class="text-green-600 font-semibold">Abrir Chat →</span>
          </a>
        )}

        {robot.demoTelegram && (
          <a
            href={robot.endesarrollo ? '#' : robot.demoTelegram}
            target={robot.endesarrollo ? '_self' : '_blank'}
            rel="noopener noreferrer"
            class={`block ${robot.endesarrollo ? 'bg-gray-100 border-2 border-gray-300 cursor-not-allowed opacity-60' : 'bg-blue-50 border-2 border-blue-200 hover:shadow-lg'} rounded-xl p-8 text-center transition-shadow`}
            onclick={robot.endesarrollo ? 'return false;' : ''}
          >
            <svg class="w-16 h-16 mx-auto mb-4 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
            <h3 class="font-bold text-gray-900 mb-2">Demo en Telegram</h3>
            <p class="text-sm text-gray-600 mb-4">Probalo en Telegram Bot</p>
            <span class="text-blue-600 font-semibold">Abrir Bot →</span>
          </a>
        )}

        <div class="block bg-gray-50 border-2 border-gray-200 rounded-xl p-8 text-center">
          <div class="w-16 h-16 mx-auto mb-4 bg-gray-200 rounded-full flex items-center justify-center">
            <span class="text-3xl">💻</span>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Demo Local</h3>
          <p class="text-sm text-gray-600 mb-4">Para desarrollo</p>
          <code class="text-xs text-gray-500 break-all block">{robot.demoLocal}</code>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        ¿Querés este bot para tu negocio?
      </h2>
      <p class="text-xl text-gray-600 mb-8">
        Configuramos {robot.nombre.split(' ')[0]} con los datos de tu empresa y lo ponemos a laburar
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/#contacto"
          class={`inline-block px-8 py-4 bg-gradient-to-r ${gradientClass} text-white rounded-full font-bold text-lg transition-opacity hover:opacity-90 shadow-lg`}
        >
          Contratar {robot.nombre.split(' ')[0]} →
        </a>
        <a
          href="/robots"
          class="inline-block px-8 py-4 bg-white border-2 border-gray-300 text-gray-700 rounded-full font-semibold text-lg hover:bg-gray-50 transition-colors"
        >
          ← Ver Otros Robots
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
