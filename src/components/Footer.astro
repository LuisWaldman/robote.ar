---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- About -->
      <div class="col-span-1 md:col-span-2">
        <h3 class="text-white text-xl font-bold mb-4">🤖 Robote.ar</h3>
        <p class="text-gray-400 mb-4">
          Automatizá tu negocio con inteligencia artificial. Bots especializados para PyMEs y medianas empresas argentinas.
        </p>
        <p class="text-sm text-gray-500">
          Difundiendo la robótica y la IA en Argentina
        </p>
      </div>

      <!-- Links -->
      <div>
        <h4 class="text-white font-semibold mb-4">Navegación</h4>
        <ul class="space-y-2">
          <li><a href="/" class="hover:text-white transition-colors">Inicio</a></li>
          <li><a href="/robots" class="hover:text-white transition-colors">Robots</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-white font-semibold mb-4">Contacto</h4>
        <ul class="space-y-2">
          <li>
            <a href="mailto:contacto@robote.ar" class="hover:text-white transition-colors">
              contacto@robote.ar
            </a>
          </li>
          <li>
            <a href="https://wa.me/549" class="hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">
              WhatsApp
            </a>
          </li>
          <li>
            <a href="https://t.me/" class="hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">
              Telegram
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 mt-8 pt-8 text-center text-sm text-gray-500">
      <p>&copy; {currentYear} Robote.ar - Todos los derechos reservados</p>
      <p class="mt-2">Hecho con 💙 en Argentina</p>
    </div>
  </div>
</footer>
